{
  "name": "overdrive-development",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check": "node -e \"for (const f of require('fs').readdirSync('plugins/overdrive/scripts')) require('child_process').execFileSync(process.execPath, ['--check', 'plugins/overdrive/scripts/' + f], { stdio: 'inherit' })\"",
    "test": "node --test tests/*.test.mjs",
    "validate:plugin": "python -c \"import os,runpy,sys;sys.argv=['validate_plugin.py','plugins/overdrive'];runpy.run_path(os.path.join(os.environ.get('CODEX_HOME',os.path.expanduser('~/.codex')),'skills','.system','plugin-creator','scripts','validate_plugin.py'),run_name='__main__')\""
  }
}
